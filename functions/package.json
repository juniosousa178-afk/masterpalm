{
  "name": "mp-functions",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "deploy:one:createPreference": "firebase deploy --only functions:createPreference",
    "deploy:one:mpWebhook": "firebase deploy --only functions:mpWebhook",
    "deploy:one:planCreatePreference": "firebase deploy --only functions:planCreatePreference",
    "deploy:one:planWebhook": "firebase deploy --only functions:planWebhook",
    "deploy:one:provisionSubdomain": "firebase deploy --only functions:provisionSubdomain",
    "deploy:one:onLojaCreated": "firebase deploy --only functions:onLojaCreated",
    "deploy:one:publishLojaDraft": "firebase deploy --only functions:publishLojaDraft",
    "deploy:one:calcularCorreios": "firebase deploy --only functions:calcularCorreios",
    "deploy:one:calcularMelhorEnvio": "firebase deploy --only functions:calcularMelhorEnvio",
    "deploy:one:calcularFrenet": "firebase deploy --only functions:calcularFrenet",
    "deploy:one:generateProductThumbnail": "firebase deploy --only functions:generateProductThumbnail",
    "backfill:pedido-status-publico": "node ./backfill_pedido_status_publico.js",
    "backfill:fontes-cliente-pedidos": "node ./backfill_fontes_cliente_pedidos.js",
    "backfill:catalog-redirect-index": "node ./backfill_catalog_redirect_index.js",
    "backfill:catalog-redirect-index:dry": "node ./backfill_catalog_redirect_index.js --dry-run",
    "backfill:order-loja-index": "node ./backfill_order_loja_index.js",
    "backfill:order-loja-index:dry": "node ./backfill_order_loja_index.js --dry-run",
    "lint": "echo \"no lint\"",
    "test": "node --test test/scheduledExpiredPaidReconcileBatch.test.js test/mpPlanRecurring.test.js test/mpPlanChange.test.js test/plan_callable_exports_contract.test.js test/mpCatalogP1.test.js test/mpCatalogPaymentLock.test.js test/mpCatalogProviderIdempotencyKey.test.js test/mpStructuredLogsMp.test.js test/mpCatalogPaymentSupportRead.test.js test/mpWebhookValidationReject.test.js test/mpWebhookCatalogEdge.test.js test/planSupportRead_audit.test.js test/planSupportRead_audit_events.test.js test/planSupportRead_integration.test.js test/pedidoClienteStatusEmail.test.js test/masterPlanCourtesy.test.js test/planEffectiveAccessResolver.test.js test/subscription_webhook.test.js test/subscription_lifecycle.test.js test/subscription_idempotency.test.js test/subscription_security.test.js",
    "test:rules:planos": "firebase emulators:exec --only firestore --project masterpalm-rules-p1-local \"node test/rules-master-plan-emulator.mjs\"",
    "test:planos:e2e": "firebase emulators:exec --project masterpalm-planos-e2e-local --only auth,firestore,functions \"node test/e2e/planos-fullstack-runner.mjs\"",
    "test:rules:stock": "firebase emulators:exec --only firestore --project masterpalm-stock-r84-local \"node test/rules-stock-revision-emulator.mjs && node test/stock-revision-readback-emulator.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-e2e-mp \"node --import ./test/e2e/prelude-firestore-emulator.mjs --test ./test/e2e/scheduledExpiredPaidReconcile.e2e.js\"",
    "test:e2e:only": "node --import ./test/e2e/prelude-firestore-emulator.mjs --test ./test/e2e/scheduledExpiredPaidReconcile.e2e.js",
    "setup": "npm i firebase-admin@^13.6.0 dotenv@^16.6.1",
    "seed": "node ./scripts/update_all.js",
    "seed:one": "node ./scripts/update_all.js --loja",
    "seed:exec": "firebase emulators:exec --only firestore \"node ./scripts/update_all.js\"",
    "fix:gateways": "node ./scripts/fix_payments_gateways.js",
    "seed:fretes": "node ./scripts/seed_fretes_e_gateways.js",
    "criar-usuario-teste": "node ./scripts/criar_usuario_teste.js",
    "firestore:tree": "node ./scripts/firestore_tree.js",
    "migrar:participantes": "node ./scripts/migrar_participantes_schema.js",
    "migrar:participantes:dry": "node ./scripts/migrar_participantes_schema.js --dry-run",
    "backfill:catalogo-estoque": "node ./scripts/backfill_catalogo_from_estoque.js",
    "backfill:catalogo-estoque:dry": "node ./scripts/backfill_catalogo_from_estoque.js --dry-run",
    "backfill:custo-peso-all": "node ./scripts/backfill_catalogo_from_estoque.js --all-lojas --only-custo-peso",
    "backfill:custo-peso-all:dry": "node ./scripts/backfill_catalogo_from_estoque.js --all-lojas --only-custo-peso --dry-run",
    "backfill:payments-public": "node ./scripts/backfill_payments_public.js",
    "backfill:payments-public:dry": "node ./scripts/backfill_payments_public.js --dry-run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^9.15.1",
    "mercadopago": "^2.2.6",
    "nodemailer": "^7.0.11",
    "picomatch": "^4.0.3",
    "sharp": "^0.33.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.10.0",
    "firebase-tools": "^15.9.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "semver": "^7.6.3",
    "glob": "^11.0.0",
    "node-forge": "^1.3.1",
    "fast-xml-parser": "^5.3.8"
  }
}
